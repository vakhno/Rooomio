{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": ".",
		"outDir": "./dist",
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts", "playwright.config.ts"],
	"exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
